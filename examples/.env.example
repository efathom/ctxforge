# ctxforge demo configuration
# Copy this file to .env and fill in the values you need.
# The examples load `.env` automatically (via python-dotenv).

# ---------------------------------------------------------------------------
# LLM provider — choose ONE of the options below, then set
# CTXFORGE_LLM_PROVIDER to openai | openrouter | azure.
# ---------------------------------------------------------------------------

# Option A — OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=1000
OPENAI_TEMPERATURE=0.7

# Option B — OpenRouter (OpenAI-compatible API)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
#OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
#OPENROUTER_HTTP_REFERER=https://example.com
#OPENROUTER_SITE_TITLE=My App

# Option C — Azure OpenAI (uses deployment names, not model IDs)
#AZURE_OPENAI_API_KEY=
#AZURE_OPENAI_ENDPOINT=https://<resource-name>.openai.azure.com
#AZURE_OPENAI_API_VERSION=2024-02-15-preview
#AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
#AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
#CA_BUNDLE_TRUST_CA_FILE=

# Active LLM provider: openai | openrouter | azure
CTXFORGE_LLM_PROVIDER=openrouter

# ---------------------------------------------------------------------------
# Embeddings
# ---------------------------------------------------------------------------
# Option A — self-hosted OpenAI-compatible server (TEI / Ollama / vLLM)
LOCAL_EMBEDDING_PROVIDER=openai
LOCAL_EMBEDDING_BASE_URL=http://localhost:8080/v1
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
LOCAL_EMBEDDING_DIMENSION=384
#LOCAL_EMBEDDING_API_KEY=
# Option B — in-process sentence-transformers (no server):
#            set LOCAL_EMBEDDING_PROVIDER=local

# ---------------------------------------------------------------------------
# Optional storage (only needed by demos that exercise these backends)
# ---------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ctxforge
POSTGRES_USER=ctxforge
POSTGRES_PASSWORD=password

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=ctxforge
MYSQL_USER=ctxforge
MYSQL_PASSWORD=password

NEO4J_URL=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
#NEO4J_DATABASE=neo4j

CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION=memories
